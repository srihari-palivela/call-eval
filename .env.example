# Copy to .env (repo root or apps/api) and fill in what you use. Everything is optional for a local
# demo: with no keys the platform runs on an embedded PostgreSQL with the heuristic judge. Blank values
# count as unset, so you can leave any line empty.

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Public base URL; webhook URLs shown in the console are built from it.
PUBLIC_URL=http://localhost:8787
# An owner-level bearer token for automation and as a break-glass key; with no users yet, creating the
# first owner in the console asks for it. People sign in with their own accounts (docs/access.md).
API_TOKEN=
# Proxies whose X-Forwarded-For is trusted for the client address (sign-in limits, audit log).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Self-serve (SaaS): anyone can sign up and gets a workspace of their own ---
# off: one company per installation (the first owner is created in the console or with `calleval users create`).
SELF_SIGNUP=off
TRIAL_DAYS=14
# Transactional email (sign-up verification, password resets): smtp://user:pass@host:587 or smtps://user:pass@host:465
SMTP_URL=
EMAIL_FROM=Call Evaluation <no-reply@example.com>

# --- Billing: plans, pay-as-you-go credit and usage limits (Stripe) ---
# off: no limits (self-hosted). on: needs both Stripe values; the webhook endpoint is {PUBLIC_URL}/webhooks/stripe.
BILLING=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Built landing site (apps/site/dist), served at / with the console at /app/. Found automatically when built.
SITE_DIST=
# Encrypts provider keys at rest. Set a long random value in production and keep it stable.
APP_SECRET=
# on: demo data can be seeded from the console. Set off in production.
DEMO_MODE=on
LOG_LEVEL=info

# --- Database ---
# PostgreSQL in production. Leave empty to run an embedded PostgreSQL with its data in PG_DIR.
DATABASE_URL=
PG_DIR=./data/pg
UPLOAD_DIR=./data/uploads

# --- Workers ---
# Run the job workers and scheduler in this process (false on web-only instances).
RUN_WORKER=true
WORKER_CONCURRENCY=2

# --- Claude (LLM judge, recommendations, clustering) ---
ANTHROPIC_API_KEY=
# auto: use Claude when a key is set; off: always use the heuristic judge.
LLM_JUDGE=auto
# Scoring costs about $0.15 a call on Opus 5.5 and $0.08 on Sonnet 5.5 (3-minute call); the published plan prices
# assume Sonnet 5.5. Check its scores against your reviewers' before switching.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_RECOMMENDATION_EFFORT=high
# Server-side refusal fallbacks are on by default; set off to disable.
CLAUDE_FALLBACKS=on
CLAUDE_MAX_CONCURRENT=4

# --- ElevenLabs (created as an integration on start when the key is set) ---
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Comma-separated; empty imports every agent.
ELEVENLABS_AGENT_IDS=
ELEVENLABS_BASE_URL=
# Speech-to-Text for uploaded recordings (defaults to ELEVENLABS_API_KEY).
ELEVENLABS_STT_API_KEY=

# --- Retell AI ---
RETELL_API_KEY=
RETELL_AGENT_IDS=
RETELL_BASE_URL=

# --- CRM (Treppan or a mapping service: GET {url}/outcomes?since=ISO) ---
TREPPAN_API_URL=
TREPPAN_API_KEY=

# --- Lead finder (Apollo.io; or add the integration in the console) ---
APOLLO_API_KEY=

# --- Self-improvement loop (campaigns; probes run only with ANTHROPIC_API_KEY) ---
# Model for simulated probe conversations (defaults to CLAUDE_MODEL).
CLAUDE_SIM_MODEL=
# Token budget per improvement cycle across all simulated conversations.
IMPROVE_TOKEN_BUDGET=1500000
IMPROVE_PROBE_TASKS=4
IMPROVE_CANDIDATES_GENERAL=2
IMPROVE_CANDIDATES_DOMAIN=2
IMPROVE_MAX_TURNS=14

# --- Audio model service (docs/audio-model.md) ---
AUDIO_MODEL_URL=

# --- Console build ---
# Directory of the built console to serve (defaults to apps/web/dist).
WEB_DIST=
