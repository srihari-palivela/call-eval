# Copy to .env (repo root or apps/api) and fill in what you use. Everything is optional for a local
# demo: with no keys the platform runs on embedded Postgres with the heuristic judge.

# --- Server ---
PORT=8787
HOST=0.0.0.0
# Public base URL; webhook URLs shown in the console are built from it.
PUBLIC_URL=http://localhost:8787
# Bearer token required on /api routes (the console asks for it). Leave empty for local use.
API_TOKEN=
# Encrypts provider keys at rest. Set a long random value in production and keep it stable.
APP_SECRET=
# on: demo data can be seeded from the console. Set off in production.
DEMO_MODE=on
LOG_LEVEL=info

# --- Database ---
# PostgreSQL in production. Leave empty to use embedded PGlite in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pglite
UPLOAD_DIR=./data/uploads

# --- Workers ---
# Run the job workers and scheduler in this process (false on web-only instances).
RUN_WORKER=true
WORKER_CONCURRENCY=2

# --- Claude (LLM judge, recommendations, clustering) ---
ANTHROPIC_API_KEY=
# auto: use Claude when a key is set; off: always use the heuristic judge.
LLM_JUDGE=auto
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_RECOMMENDATION_EFFORT=high
# Server-side refusal fallbacks are on by default; set off to disable.
CLAUDE_FALLBACKS=on
CLAUDE_MAX_CONCURRENT=4

# --- ElevenLabs (created as an integration on start when the key is set) ---
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Comma-separated; empty imports every agent.
ELEVENLABS_AGENT_IDS=
ELEVENLABS_BASE_URL=
# Speech-to-Text for uploaded recordings (defaults to ELEVENLABS_API_KEY).
ELEVENLABS_STT_API_KEY=

# --- Retell AI ---
RETELL_API_KEY=
RETELL_AGENT_IDS=
RETELL_BASE_URL=

# --- CRM (Treppan or a mapping service: GET {url}/outcomes?since=ISO) ---
TREPPAN_API_URL=
TREPPAN_API_KEY=

# --- Audio model service (docs/audio-model.md) ---
AUDIO_MODEL_URL=

# --- Console build ---
# Directory of the built console to serve (defaults to apps/web/dist).
WEB_DIST=
