{
  "name": "@calleval/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Call evaluation API: provider connectors, evaluation pipeline, analytics and recommendations.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/main.js --worker-only",
    "build": "tsup",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@calleval/framework": "*",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
